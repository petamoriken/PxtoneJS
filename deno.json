{
  "name": "@petamoriken/pxtone",
  "version": "4.2.3",
  "exports": {
    ".": "./src/Pxtone.ts",
    "./bundle": "./bundle/Pxtone.mjs"
  },
  "license": "MIT",
  "publish": {
    "exclude": [
      "tests/",
      "tools/",
      "npm/",
      "node_modules/",
      ".github/",
      ".vscode/",
      "vite.config.ts",
      "bundle/Pxtone.js",
      "bundle/Pxtone.js.map",
      "deno.lock",
      "!bundle/Pxtone.mjs",
      "!bundle/Pxtone.mjs.map",
      "!bundle/Pxtone.d.mts"
    ]
  },
  "imports": {
    "@deno/dnt": "jsr:@deno/dnt@^0.43.2",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/toml": "jsr:@std/toml@^1.0.11",
    "vite": "npm:vite@^8.2.1"
  },
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "deno.ns"]
  },
  "tasks": {
    "build": "vite build && deno run -A tools/build_dts.ts",
    "build:npm": "deno run -A tools/build_npm.ts",
    "test": "deno test --allow-read=tests/ tests/"
  },
  "fmt": {
    "lineWidth": 100
  },
  "exclude": ["bundle", "npm"],
  "nodeModulesDir": "auto"
}
